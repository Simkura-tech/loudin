# Copy to `.env.production` on each deploy target and fill in real values.
# This file (`.env.production`) is gitignored so server-specific values are
# never overwritten by `git pull` during deploys.
# All vars exposed to the client must be prefixed with VITE_.

# Backend API base URL — set to your real API origin (e.g. https://api.example.com).
VITE_API_BASE_URL=https://api.yourdomain.com
