# =============================================================================
# Loudin Web — example environment configuration
# Copy to `.env` and fill in real values.
# All vars exposed to the client must be prefixed with VITE_.
# =============================================================================

# Backend API base URL.
# In dev, leave blank — the Vite proxy in vite.config.ts forwards /api → :3000.
# In production, set to your API origin (e.g. https://api.example.com).
VITE_API_BASE_URL=
