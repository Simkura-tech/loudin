{
  "name": "@loudin/api",
  "version": "1.0.0",
  "description": "Loudin API — backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node ./database/scripts/migrate.js",
    "db:seed": "node ./database/scripts/init-db.js --seed",
    "db:reset": "node ./database/scripts/init-db.js --reset --seed",
    "pretest": "node database/scripts/migrate.js",
    "test": "node --test"
  },
  "keywords": [
    "api",
    "express",
    "postgresql"
  ],
  "author": "Loudin",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "resend": "^4.8.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
