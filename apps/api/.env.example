# =============================================================================
# Loudin API — environment configuration template
# Copy to `.env` and fill in real values. Same file is used in dev and prod —
# the API loads it via dotenv at startup, and the systemd unit on the VM
# reads the same path as EnvironmentFile.
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Frontend / CORS
FRONTEND_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:8081

# Open self-service signup (see docs/deployment-shapes.md for the two
# deployment shapes). Hosting the platform as a service for many companies →
# leave true. A single company managing its own doors → set false, or
# bootstrap with `node scripts/create-admin.js --shape own-doors`, which
# stores the equivalent platform_config override (the DB row wins over this
# env var). Reseller customer-invite links keep working either way — only
# open self-signup is gated.
SIGNUPS_ENABLED=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loudin
DB_USER=postgres
DB_PASSWORD=your_database_password

# JWT secret (used by utils/jwt.js — auth scaffolding kept, auth flow being redesigned)
# Generate a strong random value for production:  openssl rand -base64 48
JWT_SECRET=change_me_in_production
JWT_EXPIRE=24h

# ── Integration credentials ──────────────────────────────────────────────────
# Everything from here down (Simkura, Resend, Google, Twilio) can ALSO be
# managed at runtime from the platform-admin "API access → Integrations" tab —
# a value saved there wins, and clearing it reverts to the env var below.
# Env vars remain the zero-DB fallback and work exactly as before.

# Simkura — REST out to Simkura's API, webhooks in from Simkura.
#
# The default below is Simkura's PUBLIC sandbox key (documented at
# https://docs.simkura.com/authentication/): read-only, no signup, three
# fixture devices — device features work out of the box for evaluation.
# For real hardware, replace it with your sk_live_… key from Simkura.
SIMKURA_API_URL=https://api.simkura.com
SIMKURA_API_KEY=sk_demo_simkura_sandbox

# HMAC secret for verifying inbound webhook signatures. Optional here:
# scripts/register-webhook.js stores the secret in the platform settings
# automatically when it registers/rotates the webhook; this env var is the
# fallback for env-only deployments.
SIMKURA_WEBHOOK_SECRET=your_simkura_webhook_secret

# Public URL Simkura POSTs device events to (used by scripts/register-webhook.js;
# also settable as "Webhook public URL" on the Integrations tab)
# SIMKURA_WEBHOOK_PUBLIC_URL=https://api.example.com/api/webhooks/simkura

# Optional: retry tuning for the Simkura REST client (defaults shown)
# SIMKURA_RETRY_MAX_ATTEMPTS=3
# SIMKURA_RETRY_BASE_DELAY_MS=1000
# SIMKURA_RETRY_MAX_DELAY_MS=8000
# SIMKURA_RETRY_JITTER_MS=500
# SIMKURA_API_TIMEOUT=10000

# Resend — transactional email (OTPs, password reset, ops alerts, demo confirmations)
# Falls back to console logging in dev if unset, so OTPs still work without a real provider.
#
# RESEND_FROM accepts either a bare email or the "Display Name <email>"
# format. The sending domain must be verified in your Resend dashboard
# (Sending → Domains) or the first send returns 403.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Loudin Access Control <noreply@example.com>
OPS_ALERT_EMAIL=ops@example.com

# Google OAuth — sign in with Google
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Add GOOGLE_REDIRECT_URI to the OAuth 2.0 client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# Twilio — SMS 2FA (optional; email-only 2FA is supported)
TWILIO_ACCOUNT_SID=TWILIO_ACCOUNT_SID_placeholder
TWILIO_AUTH_TOKEN=TWILIO_AUTH_TOKEN_placeholder
TWILIO_FROM_NUMBER=+15551234567
