# Dependencies
node_modules/
*/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/*/.env
apps/*/.env.local
apps/*/.env.production
apps/api/.env.*
# …but the committed template must survive a fresh `git add` (a fresh
# clone/export re-applies these rules; without the negation the example
# file silently drops out of the repo)
!apps/api/.env.example

# Logs
logs
*.log
logs.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
apps/*/dist/
apps/*/build/

# Claude Code
.claude/

# IDE
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
.nyc_output/

# Misc
*.local
.cache/
temp/
tmp/
nul

# nRF Cloud MQTT Certificates (sensitive)
apps/api/mqtt/config/certs/

# Uploaded media (product images etc.) — served from disk, not tracked in git
apps/api/uploads/
checklist.md
