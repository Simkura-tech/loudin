[Unit]
Description=Loudin scheduled subscription cancellations
After=network.target cloud-sql-proxy.service
Requires=cloud-sql-proxy.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/loudin/apps/api
EnvironmentFile=/opt/loudin/apps/api/.env
ExecStart=/usr/bin/node scripts/process-scheduled-cancellations.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loudin-scheduled-cancellations
